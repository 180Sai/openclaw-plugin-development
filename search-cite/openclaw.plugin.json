{
  "id": "search-cite",
  "name": "Search and Cite",
  "description": "Searches the web, fetches sources, and returns grounded, verifiable citations.",
  "contracts": {
    "tools": ["search_and_cite"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "provider": {
        "type": "string",
        "enum": ["mock", "http"]
      },
      "maxSources": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "minTrust": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  }
}
